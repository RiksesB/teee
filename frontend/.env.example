# Niblion Frontend - Variables de Entorno

# URL de la API Backend
VITE_API_URL=http://localhost:3000/api

# PayPal Configuration (Producción/Sandbox)
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id_here
VITE_PAYPAL_MODE=sandbox

# Gophish Integration
VITE_GOPHISH_URL=https://your-gophish-instance.com

# Analytics (opcional)
VITE_GOOGLE_ANALYTICS_ID=
VITE_MIXPANEL_TOKEN=

# Feature Flags
VITE_ENABLE_PAYPAL=true
VITE_ENABLE_MOBILE_PAYMENT=true
VITE_ENABLE_BANK_TRANSFER=true
VITE_ENABLE_GOPHISH=true

# App Configuration
VITE_DEFAULT_LANGUAGE=es
VITE_MAX_PEOPLE_PER_CAMPAIGN=500
VITE_PRICE_PER_PERSON_USD=5.99
VITE_PRICE_PER_PERSON_VES=220
